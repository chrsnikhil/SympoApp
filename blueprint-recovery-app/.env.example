# Environment Variables — Blueprint Recovery
# See: Backend Schema & Implementation Plan, Section 5
#
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and never committed.

# Supabase project URL (public, safe to expose)
VITE_SUPABASE_URL=

# Supabase anon/publishable key (public, scoped by RLS policies)
VITE_SUPABASE_ANON_KEY=

# Coordinator dashboard password (simple shared secret)
VITE_COORDINATOR_PASSWORD=

# NOTE: SUPABASE_SERVICE_ROLE_KEY is intentionally NOT listed here.
# It is used ONLY in Supabase Edge Functions (server-side).
# Set it in: Supabase Dashboard → Edge Functions → Secrets
# NEVER expose it in frontend code or .env files.
