# Copy to .env.local and fill in. Everything here is SERVER-ONLY — no NEXT_PUBLIC_
# prefixes, so none of it is ever shipped to a browser.

# ── Core ─────────────────────────────────────────────────────────────────────
MONGODB_URI="mongodb://127.0.0.1:27017/xplore26"
JWT_SECRET="change-me-to-a-long-random-string"

# Optional: point at a real local mongod instead of MONGODB_URI.
# USE_LOCAL_DB=true
# MONGODB_URI_LOCAL="mongodb://127.0.0.1:27117/xplore26"
# MONGODB_DB=xplore26

# Root domain the session cookie is scoped to. Leave unset for localhost.
# COOKIE_DOMAIN=".example.com"

# ── Round 1, Game 1: Image Replication judging ───────────────────────────────
# Judged by ONE vision model. The app needs no companion service and no
# container to score a picture — just an API key and a model id.

# API key for the vision provider (either is accepted).
OPENROUTER_API_KEY=""
# GROQ_API_KEY=""

# Vision model id(s), comma-separated and tried in order. There is no default:
# ids change, and an invalid one fails every request. A fallback list matters
# on free tiers, where the cheap models are the ones that 429 under load.
# Discover ids your key can actually use:
#   npx tsx --env-file=.env.local scripts/find-vision-model.ts
IMAGE_JUDGE_MODEL="google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free"

# Override only if you are not using OpenRouter's OpenAI-compatible endpoint.
# VISION_API_URL="https://openrouter.ai/api/v1/chat/completions"

# Marks ladder (similarity -> marks out of 10). First band met, from the top
# down. Below IMAGE_SCORE_MIN_SIMILARITY the image counts as unrelated to the
# reference and scores 0 — that and cheating detection are the only routes to
# zero for a genuine attempt.
IMAGE_SCORE_BANDS="0.95:10,0.85:9,0.70:8,0.55:6,0.40:4,0.25:2"
IMAGE_SCORE_MIN_SIMILARITY="0.25"

# ── Retired: local SigLIP evaluator ──────────────────────────────────────────
# `ai-image-eval-platform/` still holds a self-contained FastAPI + SigLIP 2
# service, preserved intact as a future alternative to the vision model above.
# It is NOT wired into the web app: there is no client, no health check and no
# polling code in `src/` any more, so none of its settings belong in this file.
#
# To reconnect it later: restore an HTTP client for the contract in
# `ai-image-eval-platform/frontend/API_CONTRACT.md`, branch in
# `src/lib/quiz/imageRound.ts`, and reintroduce something like
#   AI_EVAL_SERVICE_URL="http://localhost:8000/api/v1"
#   AI_EVAL_MAX_SCORE="100"
